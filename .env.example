# Mesmo Postgres da API. O painel lê escritórios, usuários, clientes, processos e convites.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Login da equipe interna. Não é usuário de um escritório.
PANEL_EMAIL=equipe@nomos.local
PANEL_PASSWORD=painel-interno
PANEL_SECRET=troque-esta-chave-do-painel

# URL pública do sistema dos escritórios. O detalhe do escritório aponta para lá.
APP_URL=http://localhost:3000

# Render / Nixpacks: cole estas variáveis em Environment.
# A porta do container segue PORT (padrão 3000).
# PORT=3000
